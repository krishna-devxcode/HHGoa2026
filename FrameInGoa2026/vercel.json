{
  "version": 2,
  "buildCommand": "true",
  "outputDirectory": ".",
  "env": {
    "NODE_ENV": "production"
  },
  "redirects": [
    {
      "source": "/api/upload",
      "destination": "/api/index.js",
      "permanent": false
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/share/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(?!api|share).*",
      "dest": "/index.html",
      "status": 200
    }
  ]
}
